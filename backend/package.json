{
  "name": "x-agent-backend",
  "version": "3.0.0",
  "description": "X-Agent: Advanced Twitter Analytics with Embeddings",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "collect": "node scripts/continuous-collector.js",
    "embeddings": "node scripts/generate-embeddings.js",
    "db:generate": "npx dotenv-cli -e ../.env -- prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "npx dotenv-cli -e ../.env -- npx prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "npx dotenv-cli -e ../.env -- npx prisma db push --schema=prisma/schema.prisma",
    "db:studio": "npx dotenv-cli -e ../.env -- npx prisma studio --schema=prisma/schema.prisma",
    "db:reset": "npx dotenv-cli -e ../.env -- npx prisma migrate reset --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@xenova/transformers": "^2.17.1",
    "axios": "^1.7.7",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "hnswlib-node": "^3.0.0",
    "node-cron": "^3.0.3",
    "openai": "^4.63.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^6.16.2",
    "dotenv-cli": "^7.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }

}
