# X.com API Configuration
# Get these from https://developer.x.com/en/portal/dashboard
X_COM_BEARER_TOKEN=your_bearer_token_here
X_COM_API_KEY=your_api_key_here
X_COM_API_SECRET=your_api_secret_here
# X_COM_ACCESS_TOKEN=your_access_token_here
# X_COM_ACCESS_TOKEN_SECRET=your_access_token_secret_here
X_COM_USERNAME=your_twitter_username
X_COM_APP_ID=your_app_id_here
X_COM_USER_ID=your_user_id_here

# AI API Configuration
# Get your API key from https://x.ai
# XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=your_xai_api_key_here


# Database Configuration
DATABASE_URL="file:./dev.db"


# Server Configuration
BACKEND_PORT=3001
FRONTEND_PORT=1122
NODE_ENV=development

# Rate Limiting Configuration
API_TIER=enterprise
# Options: basic, pro, pro_plus, enterprise

# Collection Settings
MAX_TWEETS_PER_SESSION=0  # 0 = unlimited
COLLECTION_COOLDOWN_MS=0

# Embedding Configuration
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_DIM=384
EMBEDDINGS_BATCH_SIZE=256

# Similarity Configuration
SIMILARITY_TOP_K=50
SIMILARITY_THRESHOLD=0.5

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Security
SESSION_SECRET=dev-secret-change-in-production

# Analytics
ANALYTICS_ENABLED=false
GA_MEASUREMENT_ID=your_ga_id_here
CORS_ORIGINS=http://localhost:1122,http://127.0.0.1:1122,https://yourdomain.com

# Constrains
EMBEDDINGS_EXCLUDE_REPLIES=true       # Exclude @ replies
EMBEDDINGS_REMOVE_AT_MENTIONS=false   # Keep @mentions
EMBEDDINGS_MIN_CHAR_LENGTH=60         # Lower minimum to 60 chars
EMBEDDINGS_REMOVE_URLS=true           # Strip URLs if desired
